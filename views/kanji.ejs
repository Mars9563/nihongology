<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kanji - Nihongology</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Yomogi&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/kanji.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/">Nihongology</a>
        </div>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/kana">Kana</a></li>
                <li class="nav-item"><a class="nav-link" href="/kanji">Kanji</a></li>
                <li class="nav-item"><a class="nav-link" href="/vocab">Vocabulary</a></li>
            </ul>
        </div>
    </nav>
    
    <div class="container mt-0 ms-0">
        <div class="row">
            <!-- Sidebar -->
            <aside class="col-md-2 sidebar">
                <div class="list-group">
                    <a href="#" class="list-group-item list-group-item-action active" data-section="kanji-section">JLPT Level Selection</a>
                    <a href="#" class="list-group-item list-group-item-action" data-section="quiz-section">Quiz</a>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="col-md-5">
                <section id="kanji-section">
                    <h2>Select JLPT Level</h2>
                    <div class="btn-group" role="group">
                        <button class="btn btn-primary jlpt-btn">JLPT N4/N5</button>
                        <button class="btn btn-primary jlpt-btn">JLPT N3</button>
                        <button class="btn btn-primary jlpt-btn">JLPT N2</button>
                        <button class="btn btn-primary jlpt-btn">JLPT N1</button>
                    </div>
                    <div class="kanji-content mt-3"></div>
                </section>
                
            </main>
            <!-- Info Box Section -->
            <main class="col-md-5  kanji-details-section">
                <div class="info-box p-3 border rounded kanji-info-box">
                    <!-- SVG Container -->
                    <div id="kanjiSVG" class="text-center mb-3 kanji-svg-wrapper">
                        <p class="text-muted svg-placeholder-text">Click a kanji to view SVG</p>
                    </div>
            
                    <!-- Kunyomi / Onyomi -->
                    <div class="row text-center mb-3 reading-row">
                        <div class="col reading-block kunyomi-block">
                            <strong class="reading-label">Kunyomi:</strong>
                            <div id="kunyomiText" class="reading-value">-</div>
                        </div>
                        <div class="col reading-block onyomi-block">
                            <strong class="reading-label">Onyomi:</strong>
                            <div id="onyomiText" class="reading-value">-</div>
                        </div>
                    </div>
            
                    <!-- English Meaning -->
                    <div class="mb-3 text-center english-block">
                        <strong class="english-label">English:</strong>
                        <div id="englishText" class="english-value">-</div>
                    </div>
            
                    <!-- Example Sentences -->
                    <div class="border p-2 rounded overflow-auto example-sentences-box" style="max-height: 200px;">
                        <strong class="example-title">Example Sentences:</strong>
                        <ul id="exampleSentences" class="mb-0 list-unstyled example-sentence-list">
                            <!-- Example sentences will appear here -->
                        </ul>
                    </div>
                </div>
            </main>

        </div>
        
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container text-center">
            <p>&copy; 2025 Nihongology. All Rights Reserved.</p>
        </div>
    </footer>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- this is for gasp -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="js/kanji.js"></script>
</body>
</html>
