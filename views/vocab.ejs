<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vocabulary - Nihongology</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Yomogi&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/vocab.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-torii-gate me-2"></i>Nihongology
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="/kana"><i class="fas fa-font me-1"></i>Kana</a></li>
                        <li class="nav-item"><a class="nav-link" href="/kanji"><i class="fas fa-kanji me-1"></i>Kanji</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/vocab"><i class="fas fa-book me-1"></i>Vocabulary</a></li>
                    </ul>
                </div>
            </div>
    </nav>

    <div class="container mt-4">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2">
                <aside class="sidebar">
                    <div class="list-group">
                        <a href="/vocab" class="list-group-item list-group-item-action active" data-section="vocab-section">JLPT Level Selection</a>
                        <a href="/vocab-quiz" class="list-group-item list-group-item-action" data-section="quiz-section">Quiz</a>
                    </div>
                </aside>
            </div>

            <!-- Main Content -->
            <div class="col-md-5">
                <main>
                    <section id="vocab-section">
                        <h2>Select JLPT Level</h2>
                        <div class="btn-group" role="group">
                            <button class="btn jlpt-btn">JLPT N5</button>
                            <button class="btn jlpt-btn">JLPT N4</button>
                            <button class="btn jlpt-btn">JLPT N3</button>
                            <button class="btn jlpt-btn">JLPT N2</button>
                            <button class="btn jlpt-btn">JLPT N1</button>
                        </div>
                        <div class="scroll-box">
                            <div class="vocab-content">
                                <table class="table vocab-table">
                                    <thead>
                                        <tr>
                                            <th>Index</th>
                                            <th>Kanji</th>
                                            <th>Furigana</th>
                                            <th>English</th>
                                        </tr>
                                    </thead>
                                    <tbody id="vocabTableBody">
                                        <!-- Vocabulary rows will be inserted here dynamically -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                    
                    <section id="quiz-section">
                        <h2>Japanese Vocabulary Quiz</h2>
                        <!-- Quiz content would go here -->
                        <div class="alert alert-info">
                            Quiz functionality coming soon!
                        </div>
                    </section>
                </main>
            </div>
            
            <!-- Vocab Details Section -->
            <div class="col-md-5">
                <main class="vocab-details-section">
                    <div class="vocab-info-box">
                        <!-- SVG-like Vocab Characters Drawing Area -->
                        <div id="vocabSVG" class="text-center mb-3 vocab-svg-wrapper">
                            <p class="svg-placeholder-text">Click a word to see details</p>
                            <div id="vocabCharacterContainer" class="d-flex justify-content-center flex-wrap gap-2">
                                <!-- Characters will be injected one by one -->
                            </div>
                        </div>
                
                        <!-- Furigana -->
                        <div class="mb-3 text-center reading-row">
                            <strong class="reading-label">Furigana:</strong>
                            <div id="furiganaText" class="reading-value">-</div>
                        </div>
                
                        <!-- English Meaning -->
                        <div class="mb-3 text-center english-block">
                            <strong class="english-label">English:</strong>
                            <div id="englishText" class="english-value">-</div>
                        </div>
                
                        <!-- Vocab Type (like noun, verb, etc.) -->
                        <div class="mb-3 text-center type-block">
                            <strong class="english-label">Type:</strong>
                            <div id="vocabType" class="english-value text-muted">-</div>
                        </div>
                
                        <!-- Example Sentences -->
                        <div class="example-sentences-box">
                            <strong class="example-title">Example Sentences:</strong>
                            <ul id="exampleSentences" class="mb-0 list-unstyled example-sentence-list">
                                <!-- Example sentences will appear here -->
                            </ul>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer mt-5">
            <div class="container text-center">
                <p>© 2025 Nihongology - The modern way to learn Japanese</p>
                <div class="social-links mt-3">
                    <a href="#" class="social-link"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="social-link"><i class="fab fa-youtube"></i></a>
                    <a href="#" class="social-link"><i class="fab fa-discord"></i></a>
                </div>
            </div>
        </footer>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- this is for gasp -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="/js/vocab.js"></script>
</body>
</html>